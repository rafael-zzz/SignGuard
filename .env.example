# Copie para .env (na raiz do repo). NUNCA commite o .env.

# --- LLM (OpenRouter) — Rafael
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Modelos grátis mudam: confira em https://openrouter.ai/models?q=free
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tempo total de LLM por análise, em segundos (decoder + judge). Estourou -> veredito só com regras.
LLM_TIMEOUT=6

# --- RAG (padrões de golpe) — Rafael
# chroma = índice vetorial (cai para tags se o chromadb faltar) | tags = só tags e palavras-chave
RAG_BACKEND=chroma
# local = embeddings calculados aqui, sem download | minilm = modelo do Chroma (~80 MB na 1ª vez)
RAG_EMBEDDINGS=local

# --- Modo demo: 1 = sem LLM, sem RPC, sem Etherscan (usa fixtures + regras)
OFFLINE=0

# --- Blockchain — Davi
# Mainnet (ou o fork local: anvil --fork-url <mainnet> -> http://127.0.0.1:8545)
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
# Carteira SÓ de testnet, com ETH de faucet. Nunca use chave de carteira real.
ATTESTER_PRIVATE_KEY=
REGISTRY_ADDRESS=

# Preço fixo para a demo
ETH_USD=3000
