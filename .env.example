# Copie para .env (na raiz do repo). NUNCA commite o .env.

# --- LLM (OpenRouter) — Rafael
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Modelos grátis mudam: confira em https://openrouter.ai/models?q=free
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Classificador Jev (TypeSafe AI) — Rafael. Chave em console.typesafe.ai
TYPESAFE_API_KEY=
# Versão fixada (não use jev-latest: muda sem aviso)
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT=2

# --- Modo demo: 1 = sem LLM, sem RPC, sem Etherscan (usa fixtures + regras)
OFFLINE=0

# --- Blockchain — Davi
# Mainnet (ou o fork local: anvil --fork-url <mainnet> -> http://127.0.0.1:8545)
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
# Carteira SÓ de testnet, com ETH de faucet. Nunca use chave de carteira real.
# Com prefixo 0x (o script de deploy do Foundry exige).
ATTESTER_PRIVATE_KEY=
# Opcional: outra carteira autorizada a atestar (padrão = a do ATTESTER_PRIVATE_KEY)
ATTESTER_ADDRESS=
# Preenchido após o deploy (forge script imprime o endereço)
REGISTRY_ADDRESS=

# Preço fixo para a demo
ETH_USD=3000

# Modo de demonstração: desativa a autenticação da API.
# Utilize somente em ambiente local ou controlado. Apenas o valor literal 1 ativa.
SIGNGUARD_DEMO_MODE=1

# Mapeamento JSON de proprietários para tokens Bearer distintos.
# Cada token deve possuir no mínimo 32 caracteres.
# Utilizado quando SIGNGUARD_DEMO_MODE não está ativado.
# Sem chaves nesse modo: HTTP 503; com chaves e sem token válido: HTTP 401.
# SIGNGUARD_API_KEYS={"default":"substitua-por-um-token-seguro-com-32-caracteres"}

# Token Bearer usado pelos clientes autenticados.
# SIGNGUARD_API_TOKEN=
